<?xml version="1.0" encoding="utf-8"?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0" xmlns:isee="http://iseesystems.com/XMILE">
	<header>
		<smile version="1.0" namespace="std, isee"/>
		<name>uzasny_SYSP_Mrsky_Ani_Tony</name>
		<uuid>532c549a-f89b-4bc7-96e4-f32e74861a5c</uuid>
		<vendor>isee systems, inc.</vendor>
		<product version="1.9" isee:build_number="1841" isee:saved_by_v1="true" lang="en">Stella Professional</product>
	</header>
	<sim_specs isee:simulation_delay="0.0136986" isee:restore_on_start="false" method="CYCLE_TIME" time_units="Days" isee:instantaneous_flows="false">
		<start>1</start>
		<stop>365</stop>
		<dt>1</dt>
	</sim_specs>
	<isee:prefs show_module_prefix="true" live_update_on_drag="true" show_restore_buttons="false" layer="model" interface_scale_ui="true" interface_max_page_width="10000" interface_max_page_height="10000" interface_min_page_width="0" interface_min_page_height="0" saved_runs="5" keep="false" rifp="true"/>
	<isee:multiplayer_settings include_chat="true" allow_observers="false" advance_time_increment="1" observer_start_page="home_page" enabled="false"/>
	<isee:time_formats default_format="Builtin">
		<isee:time_format name="Builtin" type="adaptive"/>
	</isee:time_formats>
	<default_format/>
	<model_units>
		<unit name="Dimensionless">
			<eqn>1</eqn>
			<alias>dmnl</alias>
			<alias>unitless</alias>
			<alias>fraction</alias>
		</unit>
		<unit name="Days">
			<eqn/>
			<alias>day</alias>
		</unit>
		<unit name="Hours">
			<eqn/>
			<alias>hr</alias>
			<alias>hour</alias>
		</unit>
		<unit name="Watts">
			<eqn/>
			<alias>w</alias>
			<alias>watt</alias>
		</unit>
		<unit name="Nálada">
			<eqn/>
			<alias>nld</alias>
		</unit>
		<unit name="Pohodlí Domova">
			<eqn/>
			<alias>phdm</alias>
		</unit>
		<unit name="Počet panelů">
			<eqn/>
			<alias>panel</alias>
		</unit>
		<unit name="Koruny">
			<eqn/>
			<alias>Kč</alias>
		</unit>
	</model_units>
	<model>
		<variables>
			<stock name="baterie">
				<doc>https://www.klik.cz/blog/prumerna-spotreba-kwh-za-den/
podle odkazu denní spotřeba bývá ~8kWh na den</doc>
				<eqn>000</eqn>
				<inflow>&quot;solarní_energie_(naše)&quot;</inflow>
				<inflow>energie_od_dodavatele</inflow>
				<outflow>spotřeba</outflow>
				<outflow>přebytek</outflow>
				<non_negative/>
				<units>Watts</units>
			</stock>
			<stock name="pracovní hodiny">
				<doc>hodiny v práci. 8h předpoklad 100% výplaty:
12h &gt; hodiny &gt; 8h = 100% výplaty + premie
8h = 100% výplata
0h =&lt; hodiny &lt; 8h = 0% =&lt; výplata &lt; 100%</doc>
				<eqn>0</eqn>
				<inflow>pracovitost</inflow>
				<outflow>hodinový_odečet</outflow>
				<non_negative/>
				<units>Hours</units>
			</stock>
			<stock name="dostupné finance">
				<doc>aktuální finanční situace.
přímo ovlivňuje náladu.
koeficient nálady:
&gt;500000 = 1,5 &gt;= nalada &gt;1
  500000 = nalada = 1
&lt;500000 = 1 &lt; nalada =&lt; 0</doc>
				<eqn>50000</eqn>
				<inflow>příjmy</inflow>
				<outflow>výdaje</outflow>
				<outflow>spoření</outflow>
				<units>Koruny</units>
			</stock>
			<flow name="solarní energie (naše)">
				<doc>energie z našich solárních panelů
(panel vyrobí za rok cca 450kWh což odpovídá 1,2kWh na den)
- - - - -
počet_panélů * 1,2kWh * počasí</doc>
				<eqn>(počet_panelů * 800 * počasí)/2</eqn>
				<non_negative/>
				<units>Watts/Day</units>
			</flow>
			<flow name="energie od dodavatele">
				<eqn>&quot;solarní_energie_(naše)&quot;</eqn>
				<non_negative/>
				<gf>
					<xscale min="0" max="6000"/>
					<yscale min="0" max="6"/>
					<ypts>6000,5400,4800,4200,3600,3000,2400,1800,1200,600,0</ypts>
				</gf>
				<units>Watts/Day</units>
			</flow>
			<flow name="spotřeba">
				<eqn>IF(baterie &gt;= 6000)THEN 6000
ELSE baterie</eqn>
				<non_negative/>
				<units>Watts/Day</units>
			</flow>
			<aux name="cena panelů">
				<eqn>25000</eqn>
				<units>Koruny</units>
			</aux>
			<flow name="pracovitost">
				<doc>nabývá 0 až 1,5
ovlivnuje hodiny práce
- - - - -
nálada * 8</doc>
				<eqn>IF((Dny MOD(7)) = 6 OR(Dny MOD(7) = 0)) THEN 0
ELSE( IF(nálada &gt; 1.5) THEN 12
          ELSE (nálada * 7)+1
)</eqn>
				<non_negative/>
				<units>Hours/Day</units>
			</flow>
			<flow name="hodinový odečet">
				<doc>předpokládáme, že nám výpllata chodí na konci dne
- - - - -
pracovní_hodiny * (300 * povýšení) + prémie</doc>
				<eqn>pracovní_hodiny</eqn>
				<non_negative/>
				<units>Hours/Day</units>
			</flow>
			<flow name="příjmy">
				<doc>je součet výplaty a zisku z energetického přebytku,
který je 4,5Kč za 1kWh
- - - - -
výplata + (energetický_přebytek * 4,5)</doc>
				<eqn>výplata + (energetický_přebytek * 4.5)</eqn>
				<non_negative/>
				<units>Koruny/Day</units>
			</flow>
			<flow name="spoření">
				<doc>peníze jdouci na spořící účet</doc>
				<eqn>IF(dostupné_finance &gt;= 150000) THEN dostupné_finance * 0.01
ELSE 0</eqn>
				<non_negative/>
				<units>Koruny/Day</units>
			</flow>
			<flow name="výdaje">
				<eqn>cena_za_energie+cena_panelů*nově_pořízené_panely</eqn>
				<non_negative/>
				<units>Koruny/Day</units>
			</flow>
			<aux name="pohodlí domova">
				<doc>koeficient nálady.
nabývá hodnot 0 až 1 v závistlosti na plnost baterie.
(viz graf)
</doc>
				<eqn>baterie</eqn>
				<gf>
					<xscale min="0" max="8000"/>
					<yscale min="0" max="1"/>
					<ypts>0,0.05,0.1,0.2,0.4,0.55,0.72,0.86,0.94,0.98,1</ypts>
				</gf>
				<units>Pohodlí Domova</units>
			</aux>
			<aux name="energetický přebytek">
				<doc>1,1Kč za 1kWh</doc>
				<eqn>přebytek*0.012</eqn>
				<units>Koruny</units>
			</aux>
			<aux name="nálada">
				<doc>nabývá hodnot od 0 do 1,5 v závislosti na pohodlí a financích.
ovlivňuje pracovitost a tou hodiny práce.
</doc>
				<eqn>1 * pohodlí_domova * (IF(dostupné_finance &lt; 0) THEN 0
                                     ELSE dostupné_finance / 100000)</eqn>
				<units>Nálada</units>
			</aux>
			<flow name="přebytek">
				<eqn>IF(baterie &gt; 6000)THEN baterie - 6000
ELSE 0</eqn>
				<non_negative/>
				<units>Watts/Day</units>
			</flow>
			<aux name="cena za energie">
				<doc>4,5kč za 1kWh (energie od dodavatele je v kWh za den)</doc>
				<eqn>0.004 * energie_od_dodavatele</eqn>
				<units>Koruny</units>
			</aux>
			<aux name="mám na panel?">
				<eqn>IF(dostupné_finance &gt; 110000) THEN 1
ELSE 0</eqn>
			</aux>
			<stock name="počet panelů">
				<eqn>0</eqn>
				<inflow>nově_pořízené_panely</inflow>
				<non_negative/>
				<units>Počet panelů</units>
			</stock>
			<flow name="nově pořízené panely">
				<doc>zahrnuje max počet panelů</doc>
				<eqn>IF(počet_panelů &lt; 20 AND(&quot;mám_na_panel?&quot; &gt; 0)) THEN 1
ELSE 0</eqn>
				<non_negative/>
				<units>Počet panelů/Day</units>
			</flow>
			<aux name="přesčasy">
				<doc>SUMA hodin přesahujicích 8h
0h až 4h
- - - - -
IF(pracovní_hodiny &lt; 8) THEN přesčasy = 0
ELSE přesčasy = pracovní_hodiny - 8</doc>
				<eqn>IF(pracovní_hodiny &lt;= 8) THEN 0
ELSE pracovní_hodiny - 8</eqn>
				<units>Hours</units>
			</aux>
			<aux name="premie">
				<doc>malý koeficient navýšení výplaty.
1 až 1,5</doc>
				<eqn>přesčasy * 150</eqn>
			</aux>
			<aux name="výplata">
				<eqn>hodinový_odečet * 350 + premie</eqn>
				<units>Koruny</units>
			</aux>
			<stock name="Dny">
				<eqn>1</eqn>
				<inflow>uplynul_den</inflow>
				<non_negative/>
				<units>Days</units>
			</stock>
			<flow name="uplynul den" isee:timestamped="true">
				<eqn>1</eqn>
				<non_negative/>
				<units>Dimensionless</units>
			</flow>
			<aux name="počasí">
				<doc>generátor špatného počasí</doc>
				<eqn>RANDOM(0.2, 1, 13)</eqn>
				<units>Hours</units>
			</aux>
		</variables>
		<views>
