	<header>
		<smile version="1.0" namespace="std, isee"/>
		<name>uzasny_SYSP_Mrsky_Ani_Tony</name>
		<uuid>532c549a-f89b-4bc7-96e4-f32e74861a5c</uuid>
		<vendor>isee systems, inc.</vendor>
		<product version="1.9" isee:build_number="1841" isee:saved_by_v1="true" lang="en">Stella Professional</product>
	</header>
	<sim_specs isee:simulation_delay="0.115385" isee:restore_on_start="false" method="Euler" time_units="Months" isee:instantaneous_flows="false">
		<start>1</start>
		<stop>13</stop>
		<dt reciprocal="true">4</dt>
	</sim_specs>
	<isee:prefs show_module_prefix="true" live_update_on_drag="true" show_restore_buttons="false" layer="model" interface_scale_ui="true" interface_max_page_width="10000" interface_max_page_height="10000" interface_min_page_width="0" interface_min_page_height="0" saved_runs="5" keep="false" rifp="true"/>
	<isee:multiplayer_settings include_chat="true" allow_observers="false" advance_time_increment="1" observer_start_page="home_page" enabled="false"/>
	<isee:time_formats default_format="Builtin">
		<isee:time_format name="Builtin" type="adaptive"/>
	</isee:time_formats>
	<default_format/>
	<model_units/>
	<model>
		<variables>
			<stock name="baterie">
				<eqn>3000000</eqn>
				<inflow>&quot;solarní_energie_(domácí)&quot;</inflow>
				<inflow>energie_od_dodavatel</inflow>
				<outflow>spotřeba</outflow>
				<non_negative/>
			</stock>
			<stock name="pracovní hodiny">
				<doc>hodiny v práci. 8h předpoklad 100% výplaty:
12h &gt; hodiny &gt; 8h = 100% výplaty + premie
8h = 100% výplata
0h =&lt; hodiny &lt; 8h = 0% =&lt; výplata &lt; 100%</doc>
				<eqn>0</eqn>
				<inflow>pracovitost</inflow>
				<outflow>výplata</outflow>
				<non_negative/>
			</stock>
			<stock name="dostupné finance">
				<doc>aktuální finanční situace.
přímo ovlivňuje náladu.
koeficient nálady:
&gt;500000 = 1,5 &gt;= nalada &gt;1
  500000 = nalada = 1
&lt;500000 = 1 &lt; nalada =&lt; 0</doc>
				<eqn>500000</eqn>
				<inflow>příjmy</inflow>
				<outflow>výdaje</outflow>
				<outflow>spoření</outflow>
			</stock>
			<flow name="solarní energie (domácí)">
				<non_negative/>
			</flow>
			<flow name="energie od dodavatel">
				<non_negative/>
			</flow>
			<flow name="spotřeba">
				<non_negative/>
			</flow>
			<aux name="počasí">
				<eqn>{_l_}0 až 1</eqn>
				<gf>
					<xscale min="0" max="2"/>
					<yscale min="0" max="1"/>
					<ypts>0.00669285092428486,0.0179862099620916,0.0474258731775668,0.119202922022118,0.268941421369995,0.5,0.731058578630005,0.880797077977883,0.952574126822433,0.982013790037909,0.993307149075715</ypts>
				</gf>
			</aux>
			<aux name="počet panélů">
				<eqn>0</eqn>
			</aux>
			<aux name="cena">
				<eqn>30000</eqn>
			</aux>
			<flow name="pracovitost">
				<doc>nabývá 0 až 1,5
ovlivnuje hodiny práce</doc>
				<non_negative/>
			</flow>
			<flow name="výplata">
				<doc>hodiny práce * (hodinový plat * koeficient povýšení)</doc>
				<eqn>pracovní_hodiny*(300*povýšení)</eqn>
				<non_negative/>
			</flow>
			<flow name="příjmy">
				<eqn>{_l_}výplata+prémie+energetický_přebytek</eqn>
				<non_negative/>
			</flow>
			<flow name="spoření">
				<non_negative/>
			</flow>
			<flow name="výdaje">
				<non_negative/>
			</flow>
			<aux name="pohodlí domova">
				<doc>koeficient nálady.
nabývá hodnot 0 až 1 v závistlosti na plnost baterie.
(viz graf)
</doc>
				<eqn>baterie</eqn>
				<gf>
					<xscale min="0" max="2"/>
					<yscale min="0" max="2"/>
					<ypts>0,0.671661823340372,1.12189020768227,1.42368731900089,1.6259879725534,1.76159415595576,1.85249369905675,1.91342548497283,1.95426928251312,1.98164769876061,2</ypts>
				</gf>
			</aux>
			<aux name="povýšení">
				<doc>malý koeficient navýšení výplaty.
1 až 1,5</doc>
				<eqn>1</eqn>
			</aux>
			<aux name="energetický přebytek"/>
			<aux name="nálada">
				<doc>nabývá hodnot od 0 do 1,5 v závislosti na pohodlí a financích.
ovlivňuje pracovitost a tou hodiny práce.</doc>
				<eqn>1*dostupné_finance*pohodlí_domova</eqn>
				<gf>
					<xscale min="0" max="2"/>
					<yscale min="0" max="1.5"/>
					<ypts>0,0.0507348763160744,0.112950961458306,0.189246431783498,0.282807426160355,0.397541100800222,0.538238794150336,0.710776115701129,0.922358314521147,1.18182117423834,1.5</ypts>
				</gf>
			</aux>
			<aux name="přesčasy">
				<doc>SUMA hodin přesahujicích 8h
0h až 4h
</doc>
			</aux>
			<aux name="prémie"/>
		</variables>
